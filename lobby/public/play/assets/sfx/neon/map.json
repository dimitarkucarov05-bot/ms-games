0], "space": "2d", "text": "Wheels up. Good luck down there.", "seconds": 1.79, "added": "announcer line (RAVEN)"}, "voice.prep_weapons": {"files": ["../motel/voice/raven/prep_weapons.ogg"], "gain": 1.0, "pitch": [1.0, 1.0], "space": "2d", "text": "Weapons are on the ground. Squeeze the grip to pick one up.", "seconds": 3.18, "added": "announcer line (RAVEN)"}, "voice.prep_gates": {"files": ["../motel/voice/raven/prep_gates.ogg"], "gain": 1.0, "pitch": [1.0, 1.0], "space": "2d", "text": "Grab a hammer and board up those gates.", "seconds": 2.12, "added": "announcer line (RAVEN)"}, "voice.prep_10": {"files": ["../motel/voice/raven/prep_10.ogg"], "gain": 1.0, "pitch": [1.0, 1.0], "space": "2d", "text": "Ten seconds.", "seconds": 0.97, "added": "announcer line (RAVEN)"}, "voice.wave_1": {"files": ["../motel/voice/raven/wave_1.ogg"], "gain": 1.0, "pitch": [1.0, 1.0], "space": "2d", "text": "Wave one. Here they come.", "seconds": 1.48, "added": "announcer line (RAVEN)"}, "voice.wave_2": {"files": ["../motel/voice/raven/wave_2.ogg"], "gain": 1.0, "pitch": [1.0, 1.0], "space": "2d", "text": "Wave two. They are getting faster.", "seconds": 1.85, "added": "announcer line (RAVEN)"}, "voice.wave_3": {"files": ["../motel/voice/raven/wave_3.ogg"], "gain": 1.0, "pitch": [1.0, 1.0], "space": "2d", "text": "Wave three. Watch the fences.", "seconds": 1.79, "added": "announcer line (RAVEN)"}, "voice.wave_4": {"files": ["../motel/voice/raven/wave_4.ogg"], "gain": 1.0, "pitch": [1.0, 1.0], "space": "2d", "text": "Wave four. Stay sharp.", "seconds": 1.5, "added": "announcer line (RAVEN)"}, "voice.wave_5": {"files": ["../motel/voice/raven/wave_5.ogg"], "gain": 1.0, "pitch": [1.0, 1.0], "space": "2d", "text": "Final wave. Give them everything.", "seconds": 1.91, "added": "announcer line (RAVEN)"}, "voice.wave_clear_a": {"files": ["../motel/voice/raven/wave_clear_a.ogg"], "gain": 1.0, "pitch": [1.0, 1.0], "space": "2d", "text": "Wave cleared. Nice shooting.", "seconds": 1.54, "added": "announcer line (RAVEN)"}, "voice.wave_clear_b": {"files": ["../motel/voice/raven/wave_clear_b.ogg"], "gain": 1.0, "pitch": [1.0, 1.0], "space": "2d", "text": "That is all of them. Breathe.", "seconds": 1.47, "added": "announcer line (RAVEN)"}, "voice.wave_clear_c": {"files": ["../motel/voice/raven/wave_clear_c.ogg"], "gain": 1.0, "pitch": [1.0, 1.0], "space": "2d", "text": "Clear. Reload and patch the gates.", "seconds": 1.88, "added": "announcer line (RAVEN)"}, "voice.supply_in": {"files": ["../motel/voice/raven/supply_in.ogg"], "gain": 1.0, "pitch": [1.0, 1.0], "space": "2d", "text": "Supply drop coming in. Heads up!", "seconds": 1.88, "added": "announcer line (RAVEN)"}, "voice.supply_down": {"files": ["../motel/voice/raven/supply_down.ogg"], "gain": 1.0, "pitch": [1.0, 1.0], "space": "2d", "text": "Crate is down. Grab the new guns.", "seconds": 1.99, "added": "announcer line (RAVEN)"}, "voice.behind": {"files": ["../motel/voice/raven/behind.ogg"], "gain": 1.0, "pitch": [1.0, 1.0], "space": "2d", "text": "Right behind you!", "seconds": 1.04, "added": "announcer line (RAVEN)"}, "voice.left": {"files": ["../motel/voice/raven/left.ogg"], "gain": 1.0, "pitch": [1.0, 1.0], "space": "2d", "text": "On your left!", "seconds": 0.8, "added": "announcer line (RAVEN)"}, "voice.right": {"files": ["../motel/voice/raven/right.ogg"], "gain": 1.0, "pitch": [1.0, 1.0], "space": "2d", "text": "On your right!", "seconds": 0.86, "added": "announcer line (RAVEN)"}, "voice.above": {"files": ["../motel/voice/raven/above.ogg"], "gain": 1.0, "pitch": [1.0, 1.0], "space": "2d", "text": "Above you! Look up!", "seconds": 1.08, "added": "announcer line (RAVEN)"}, "voice.inside": {"files": ["../motel/voice/raven/inside.ogg"], "gain": 1.0, "pitch": [1.0, 1.0], "space": "2d", "text": "They are inside the fence!", "seconds": 1.32, "added": "announcer line (RAVEN)"}, "voice.gate_hit": {"files": ["../motel/voice/raven/gate_hit.ogg"], "gain": 1.0, "pitch": [1.0, 1.0], "space": "2d", "text": "They are on the gate!", "seconds": 1.06, "added": "announcer line (RAVEN)"}, "voice.gate_down": {"files": ["../motel/voice/raven/gate_down.ogg"], "gain": 1.0, "pitch": [1.0, 1.0], "space": "2d", "text": "Gate is down! Fix it!", "seconds": 1.28, "added": "announcer line (RAVEN)"}, "voice.gate_fixed": {"files": ["../motel/voice/raven/gate_fixed.ogg"], "gain": 1.0, "pitch": [1.0, 1.0], "space": "2d", "text": "Gate is holding. Good work.", "seconds": 1.78, "added": "announcer line (RAVEN)"}, "voice.blackout": {"files": ["../motel/voice/raven/blackout.ogg"], "gain": 1.0, "pitch": [1.0, 1.0], "space": "2d", "text": "Power is gone. Flashlights only.", "seconds": 2.15, "added": "announcer line (RAVEN)"}, "voice.blackout_2": {"files": ["../motel/voice/raven/blackout_2.ogg"], "gain": 1.0, "pitch": [1.0, 1.0], "space": "2d", "text": "Stay close. Watch each other's backs.", "seconds": 2.18, "added": "announcer line (RAVEN)"}, "voice.power_back": {"files": ["../motel/voice/raven/power_back.ogg"], "gain": 1.0, "pitch": [1.0, 1.0], "space": "2d", "text": "Power is back. Keep moving.", "seconds": 1.65, "added": "announcer line (RAVEN)"}, "voice.boss_in": {"files": ["../motel/voice/raven/boss_in.ogg"], "gain": 1.0, "pitch": [1.0, 1.0], "space": "2d", "text": "Something big is coming.", "seconds": 1.45, "added": "announcer line (RAVEN)"}, "voice.boss_seen": {"files": ["../motel/voice/raven/boss_seen.ogg"], "gain": 1.0, "pitch": [1.0, 1.0], "space": "2d", "text": "That is the big one. Aim for the head!", "seconds": 1.78, "added": "announcer line (RAVEN)"}, "voice.boss_rage": {"files": ["../motel/voice/raven/boss_rage.ogg"], "gain": 1.0, "pitch": [1.0, 1.0], "space": "2d", "text": "He is angry. Keep moving!", "seconds": 1.47, "added": "announcer line (RAVEN)"}, "voice.boss_leap": {"files": ["../motel/voice/raven/boss_leap.ogg"], "gain": 1.0, "pitch": [1.0, 1.0], "space": "2d", "text": "He is jumping! Move!", "seconds": 1.22, "added": "announcer line (RAVEN)"}, "voice.boss_half": {"files": ["../motel/voice/raven/boss_half.ogg"], "gain": 1.0, "pitch": [1.0, 1.0], "space": "2d", "text": "Halfway. Keep hitting him!", "seconds": 1.22, "added": "announcer line (RAVEN)"}, "voice.boss_dead": {"files": ["../motel/voice/raven/boss_dead.ogg"], "gain": 1.0, "pitch": [1.0, 1.0], "space": "2d", "text": "He is down! He is down!", "seconds": 1.34, "added": "announcer line (RAVEN)"}, "voice.reload": {"files": ["../motel/voice/raven/reload.ogg"], "gain": 1.0, "pitch": [1.0, 1.0], "space": "2d", "text": "Reload!", "seconds": 0.65, "added": "announcer line (RAVEN)"}, "voice.low_ammo": {"files": ["../motel/voice/raven/low_ammo.ogg"], "gain": 1.0, "pitch": [1.0, 1.0], "space": "2d", "text": "You are running dry.", "seconds": 1.16, "added": "announcer line (RAVEN)"}, "voice.hurt": {"files": ["../motel/voice/raven/hurt.ogg"], "gain": 1.0, "pitch": [1.0, 1.0], "space": "2d", "text": "You are hurt. Back off!", "seconds": 1.22, "added": "announcer line (RAVEN)"}, "voice.down": {"files": ["../motel/voice/raven/down.ogg"], "gain": 1.0, "pitch": [1.0, 1.0], "space": "2d", "text": "Man down! Get to your teammate!", "seconds": 1.52, "added": "announcer line (RAVEN)"}, "voice.revived": {"files": ["../motel/voice/raven/revived.ogg"], "gain": 1.0, "pitch": [1.0, 1.0], "space": "2d", "text": "Back on your feet.", "seconds": 1.08, "added": "announcer line (RAVEN)"}, "voice.last": {"files": ["../motel/voice/raven/last.ogg"], "gain": 1.0, "pitch": [1.0, 1.0], "space": "2d", "text": "You are the last one standing!", "seconds": 1.41, "added": "announcer line (RAVEN)"}, "voice.wipe": {"files": ["../motel/voice/raven/wipe.ogg"], "gain": 1.0, "pitch": [1.0, 1.0], "space": "2d", "text": "Get up. We are not done.", "seconds": 1.47, "added": "announcer line (RAVEN)"}, "voice.nice_shot": {"files": ["../motel/voice/raven/nice_shot.ogg"], "gain": 1.0, "pitch": [1.0, 1.0], "space": "2d", "text": "Nice shot.", "seconds": 0.91, "added": "announcer line (RAVEN)"}, "voice.headshot": {"files": ["../motel/voice/raven/headshot.ogg"], "gain": 1.0, "pitch": [1.0, 1.0], "space": "2d", "text": "Headshot!", "seconds": 0.61, "added": "announcer line (RAVEN)"}, "voice.keep_up": {"files": ["../motel/voice/raven/keep_up.ogg"], "gain": 1.0, "pitch": [1.0, 1.0], "space": "2d", "text": "Keep it up.", "seconds": 0.87, "added": "announcer line (RAVEN)"}, "voice.teamwork": {"files": ["../motel/voice/raven/teamwork.ogg"], "gain": 1.0, "pitch": [1.0, 1.0], "space": "2d", "text": "Now that is teamwork.", "seconds": 1.39, "added": "announcer line (RAVEN)"}, "voice.good_to_know": {"files": ["../motel/voice/raven/good_to_know.ogg"], "gain": 1.0, "pitch": [1.0, 1.0], "space": "2d", "text": "Good to know!", "seconds": 0.76, "added": "announcer line (RAVEN)"}, "voice.five_min": {"files": ["../motel/voice/raven/five_min.ogg"], "gain": 1.0, "pitch": [1.0, 1.0], "space": "2d", "text": "Five minutes to evac.", "seconds": 1.31, "added": "announcer line (RAVEN)"}, "voice.two_min": {"files": ["../motel/voice/raven/two_min.ogg"], "gain": 1.0, "pitch": [1.0, 1.0], "space": "2d", "text": "Two minutes.", "seconds": 0.75, "added": "announcer line (RAVEN)"}, "voice.one_min": {"files": ["../motel/voice/raven/one_min.ogg"], "gain": 1.0, "pitch": [1.0, 1.0], "space": "2d", "text": "One minute. Hold on!", "seconds": 1.14, "added": "announcer line (RAVEN)"}, "voice.thirty_sec": {"files": ["../motel/voice/raven/thirty_sec.ogg"], "gain": 1.0, "pitch": [1.0, 1.0], "space": "2d", "text": "Thirty seconds!", "seconds": 0.88, "added": "announcer line (RAVEN)"}, "voice.win_1": {"files": ["../motel/voice/raven/win_1.ogg"], "gain": 1.0, "pitch": [1.0, 1.0], "space": "2d", "text": "I see you. Coming in.", "seconds": 1.38, "added": "announcer line (RAVEN)"}, "voice.win_2": {"files": ["../motel/voice/raven/win_2.ogg"], "gain": 1.0, "pitch": [1.0, 1.0], "space": "2d", "text": "Get to the chopper!", "seconds": 0.98, "added": "announcer line (RAVEN)"}, "voice.win_3": {"files": ["../motel/voice/raven/win_3.ogg"], "gain": 1.0, "pitch": [1.0, 1.0], "space": "2d", "text": "Mission complete. Drinks are on me.", "seconds": 2.05, "added": "announcer line (RAVEN)"}, "voice.lose_1": {"files": ["../motel/voice/raven/lose_1.ogg"], "gain": 1.0, "pitch": [1.0, 1.0], "space": "2d", "text": "I have lost them. Returning to base.", "seconds": 2.08, "added": "announcer line (RAVEN)"}, "voice.lose_2": {"files": ["../motel/voice/raven/lose_2.ogg"], "gain": 1.0, "pitch": [1.0, 1.0], "space": "2d", "text": "You held as long as you could.", "seconds": 1.64, "added": "announcer line (RAVEN)"}, "voice.idle": {"files": ["../motel/voice/raven/idle.ogg"], "gain": 1.0, "pitch": [1.0, 1.0], "space": "2d", "text": "Hey. Wake up down there.", "seconds": 1.37, "added": "announcer line (RAVEN)"}}}